# Copy this file to .env.e2e. .env.e2e is git-ignored -- never commit it.
#
# Defaults to the production site if omitted. Override to run against a
# preview deploy or local dev server instead.
BASE_URL=https://wagingwar.com.au

# No credentials live here. Authentication is a saved browser session:
# run `npm run e2e:login` once, sign in by hand (including Clerk's
# emailed new-device code), and it saves the session to .auth/user.json
# for every test to reuse. Re-run it whenever that session expires.
