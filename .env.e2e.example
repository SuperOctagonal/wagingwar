# Copy this file to .env.e2e and fill in real values. .env.e2e is
# git-ignored -- never commit real credentials.
#
# A dedicated Clerk test user, Free or Pro plan (Pro unlocks more of the
# covered flows -- Blackbook, competitions, Insights). This account's own
# data WILL be touched (bets logged/edited/deleted, blackbook rows
# added/edited/removed, community posts/replies/votes created and
# deleted, a competition pick saved) -- never point this at a real
# punter's account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Defaults to the production site if omitted. Override to run against a
# preview deploy or local dev server instead.
BASE_URL=https://wagingwar.com.au
